{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "resolveJsonModule": true,
    "incremental": false,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "strict": false,
    "ignoreDeprecations": "6.0",
    "esModuleInterop": false
  }
}
