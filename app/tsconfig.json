{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "sourceMap": false,
    "declaration": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "incremental": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": false,
    "noUncheckedSideEffectImports": false
  },
  "include": ["../app/src/**/*"]
}
