{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "sourceMap": true,
    "declaration": true,
    "resolveJsonModule": true,
    "incremental": false,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitThis": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": false,
    "ignoreDeprecations": "6.0",
    "esModuleInterop": false
  },
  "include": ["../api/src/**/*"]
}
